<?xml version="1.0" encoding="utf-8"?><!--
  A day that was due but not completed: an empty checkbox.

  The fill is transparent and the stroke white. Tinting applies a colour filter that preserves alpha,
  so the same tint colours the border and leaves the middle empty.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="6dp" />
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@android:color/white" />
</shape>
