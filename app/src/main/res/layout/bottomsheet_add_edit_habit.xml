<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="state"
            type="com.example.dailyworktracker.ui.addedithabit.AddEditHabitScreenState" />

        <variable
            name="viewModel"
            type="com.example.dailyworktracker.ui.addedithabit.AddEditHabitViewModel" />

    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/textSheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                app:textRes="@{state.sheetTitleRes}"
                tools:text="@string/add_habit_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutEmoji"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/add_habit_emoji_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editEmoji"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="text"
                        android:maxLength="4"
                        android:text="@{state.emoji}"
                        android:textSize="22sp"
                        tools:text="&#x1FAA5;" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutTitle"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:hint="@string/add_habit_name_label"
                    app:errorTextRes="@{state.titleError}">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:text="@{state.title}" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/add_habit_schedule_label"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <!-- Filled in code: one chip per DayOfWeek, named by the platform's locale data. -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleLine="false" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchEveryDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:checked="@{state.everyDay}"
                android:text="@string/add_habit_every_day" />

            <TextView
                android:id="@+id/textScheduleError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorError"
                app:textRes="@{state.scheduleError}"
                app:visibleIf="@{state.scheduleError != null}"
                tools:text="@string/add_habit_error_no_days"
                tools:visibility="visible" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:checked="@{state.reminderEnabled}"
                android:text="@string/add_habit_reminder_label" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonReminderTime"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:icon="@drawable/ic_alarm"
                app:reminderTimeText="@{state.reminderTime}"
                app:visibleIf="@{state.reminderEnabled}"
                tools:text="09:00"
                tools:visibility="visible" />

            <!--
              Visibility is driven from code, not state: it depends on whether the notification
              permission is currently granted, which the ViewModel has no business knowing.
            -->
            <TextView
                android:id="@+id/textReminderWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/add_habit_reminder_blocked"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonCancel"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_habit_cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:enabled="@{!state.saving}"
                    android:onClick="@{() -> viewModel.onSaveClicked()}"
                    android:text="@string/add_habit_save" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</layout>
