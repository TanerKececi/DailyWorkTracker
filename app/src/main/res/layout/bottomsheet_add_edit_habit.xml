<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.example.dailyworktracker.data.model.HabitUnit" />

        <import type="com.example.dailyworktracker.data.model.TimeOfDay" />

        <variable
            name="state"
            type="com.example.dailyworktracker.ui.addedithabit.AddEditHabitScreenState" />

        <variable
            name="viewModel"
            type="com.example.dailyworktracker.ui.addedithabit.AddEditHabitViewModel" />

    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/textSheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                app:textRes="@{state.sheetTitleRes}"
                tools:text="@string/add_habit_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutEmoji"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/add_habit_emoji_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editEmoji"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="text"
                        android:maxLength="4"
                        android:text="@{state.emoji}"
                        android:textSize="22sp"
                        tools:text="&#x1FAA5;" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutTitle"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:hint="@string/add_habit_name_label"
                    app:errorTextRes="@{state.titleError}">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:text="@{state.title}">

                        <!--
                          The emoji box comes first in the layout and would otherwise take focus,
                          so an opened sheet sends the first thing typed into the icon field.
                        -->
                        <requestFocus />

                    </com.google.android.material.textfield.TextInputEditText>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/add_habit_schedule_label"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <!-- Filled in code: one chip per DayOfWeek, named by the platform's locale data. -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleLine="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/add_habit_time_of_day_label"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <!-- Any time is a chip rather than an absent selection, so the choice is always visible. -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTimeOfDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAnyTime"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="@{state.timeOfDay == null}"
                    android:onClick="@{() -> viewModel.onAnyTimeSelected()}"
                    android:text="@string/time_of_day_any" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMorning"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="@{state.timeOfDay == TimeOfDay.MORNING}"
                    android:onClick="@{() -> viewModel.onTimeOfDaySelected(TimeOfDay.MORNING)}"
                    android:text="@string/time_of_day_morning" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAfternoon"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="@{state.timeOfDay == TimeOfDay.AFTERNOON}"
                    android:onClick="@{() -> viewModel.onTimeOfDaySelected(TimeOfDay.AFTERNOON)}"
                    android:text="@string/time_of_day_afternoon" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEvening"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="@{state.timeOfDay == TimeOfDay.EVENING}"
                    android:onClick="@{() -> viewModel.onTimeOfDaySelected(TimeOfDay.EVENING)}"
                    android:text="@string/time_of_day_evening" />

            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchEveryDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:checked="@{state.everyDay}"
                android:text="@string/add_habit_every_day" />

            <TextView
                android:id="@+id/textScheduleError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorError"
                app:textRes="@{state.scheduleError}"
                app:visibleIf="@{state.scheduleError != null}"
                tools:text="@string/add_habit_error_no_days"
                tools:visibility="visible" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="?attr/colorOutlineVariant" />

            <!--
              Amount tracking. The switch chooses the kind of habit; the unit picker only appears
              once it is on, because a unit means nothing for a habit that is simply ticked off.
            -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchTrackAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:checked="@{state.amountTracked}"
                android:text="@string/add_habit_track_amount" />

            <TextView
                android:id="@+id/labelUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/add_habit_unit_label"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                app:visibleIf="@{state.amountTracked}" />

            <!--
              onClick rather than onCheckedChange: the checked state is bound from the goal, and a
              change listener would fire while that binding is applied and echo straight back.
            -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupUnits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true"
                app:visibleIf="@{state.amountTracked}">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUnitTimes"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="@{state.unit == HabitUnit.TIMES}"
                    android:onClick="@{() -> viewModel.onUnitChanged(HabitUnit.TIMES)}"
                    android:text="@string/unit_times" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUnitPages"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="@{state.unit == HabitUnit.PAGES}"
                    android:onClick="@{() -> viewModel.onUnitChanged(HabitUnit.PAGES)}"
                    android:text="@string/unit_pages" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUnitMinutes"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="@{state.unit == HabitUnit.MINUTES}"
                    android:onClick="@{() -> viewModel.onUnitChanged(HabitUnit.MINUTES)}"
                    android:text="@string/unit_minutes" />

            </com.google.android.material.chip.ChipGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:checked="@{state.reminderEnabled}"
                android:text="@string/add_habit_reminder_label" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonReminderTime"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:icon="@drawable/ic_alarm"
                app:reminderTimeText="@{state.reminderTime}"
                app:visibleIf="@{state.reminderEnabled}"
                tools:text="09:00"
                tools:visibility="visible" />

            <!--
              Visibility is driven from code, not state: it depends on whether the notification
              permission is currently granted, which the ViewModel has no business knowing.
            -->
            <TextView
                android:id="@+id/textReminderWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/add_habit_reminder_blocked"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonCancel"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_habit_cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:enabled="@{!state.saving}"
                    android:onClick="@{() -> viewModel.onSaveClicked()}"
                    android:text="@string/add_habit_save" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</layout>
