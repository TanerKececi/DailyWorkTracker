<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.example.dailyworktracker.ui.habitdetail.ChartRange" />

        <variable
            name="state"
            type="com.example.dailyworktracker.ui.habitdetail.HabitDetailDisplayState" />

        <variable
            name="viewModel"
            type="com.example.dailyworktracker.ui.habitdetail.HabitDetailViewModel" />

    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:title="@{state.habit.title ?? @string/habit_detail_title}"
                tools:title="@string/habit_detail_title" />

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            app:visibleIf="@{state.content}"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="24dp">

                <!-- Identity -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@{state.habit.emoji}"
                        android:textSize="36sp"
                        tools:text="&#x1F3C3;" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@{state.habit.title}"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            tools:text="Do sport" />

                        <TextView
                            android:id="@+id/textSchedule"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            app:scheduleBitmask="@{state.habit.scheduleDaysBitmask}"
                            tools:text="Mon, Wed, Fri" />

                    </LinearLayout>

                </LinearLayout>

                <!--
                  Records: four tiles in two rows. Three across was already tight, and the fourth
                  would not have fitted at all without shrinking the numbers past reading size.
                -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/habit_detail_records_title"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/tileCurrentStreak"
                        layout="@layout/item_stat_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:label="@{@string/habit_detail_current_streak}"
                        app:value="@{@string/habit_detail_days_value(state.habit.currentStreak)}" />

                    <include
                        android:id="@+id/tileLongestStreak"
                        layout="@layout/item_stat_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        app:label="@{@string/habit_detail_longest_streak}"
                        app:value="@{@string/habit_detail_days_value(state.habit.longestStreak)}" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/tileTotalDone"
                        layout="@layout/item_stat_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:label="@{@string/habit_detail_total_done}"
                        app:value="@{@string/habit_detail_days_value(state.habit.completedCount)}" />

                    <include
                        android:id="@+id/tileCompletionRate"
                        layout="@layout/item_stat_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        app:label="@{@string/habit_detail_completion_rate}"
                        app:value="@{@string/habit_detail_rate_value(state.habit.completionPercent)}" />

                </LinearLayout>

                <!-- History grid -->
                <TextView
                    android:id="@+id/textHeatmapTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    app:weeksShown="@{state.habit.weeksShown}"
                    tools:text="Last 12 weeks" />

                <include
                    android:id="@+id/legendHeatmap"
                    layout="@layout/view_heatmap_legend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <LinearLayout
                    android:id="@+id/rowWeekdayHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerHeatmap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:nestedScrollingEnabled="false"
                    app:items="@{state.habit.heatmap}"
                    tools:itemCount="84"
                    tools:listitem="@layout/item_heatmap_cell" />

                <TextView
                    android:id="@+id/textTotalCompletions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:totalAmount="@{state.habit.totalAmount}"
                    app:totalUnit="@{state.habit.unit}"
                    app:visibleIf="@{state.habit.amountTracked}"
                    tools:text="943 pages in total" />

                <!--
                  The grid answers "did I do it"; this answers "how much". Only a habit logged as
                  a number has anything to plot, so it is absent entirely for the others.
                -->
                <TextView
                    android:id="@+id/textChartTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/habit_detail_chart_title"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    app:visibleIf="@{state.habit.amountTracked}" />

                <!--
                  Checked state is bound from the range, so these use onClick: a checked-change
                  listener would fire while that binding is applied and echo straight back.
                -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/groupChartRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true"
                    app:visibleIf="@{state.habit.amountTracked}">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRangeWeek"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="@{state.habit.chartRange == ChartRange.WEEK}"
                        android:onClick="@{() -> viewModel.onChartRangeSelected(ChartRange.WEEK)}"
                        android:text="@string/habit_detail_range_week" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRangeMonth"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="@{state.habit.chartRange == ChartRange.MONTH}"
                        android:onClick="@{() -> viewModel.onChartRangeSelected(ChartRange.MONTH)}"
                        android:text="@string/habit_detail_range_month" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRangeYear"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="@{state.habit.chartRange == ChartRange.YEAR}"
                        android:onClick="@{() -> viewModel.onChartRangeSelected(ChartRange.YEAR)}"
                        android:text="@string/habit_detail_range_year" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!--
                  Scrolls rather than fits: a month of columns cannot be squeezed into one screen
                  and still be readable, and the recent end is the interesting one.
                -->
                <HorizontalScrollView
                    android:id="@+id/scrollChart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none"
                    app:visibleIf="@{state.habit.amountTracked}">

                    <LinearLayout
                        android:id="@+id/chartAmounts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        app:amountBars="@{state.habit.chartBars}"
                        app:barRange="@{state.habit.chartRange}" />

                </HorizontalScrollView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.ContentLoadingProgressBar
            android:id="@+id/progressLoading"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:visibleIf="@{state.loading}" />

        <LinearLayout
            android:id="@+id/groupEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="48dp"
            app:visibleIf="@{state.missing}">

            <TextView
                android:id="@+id/textEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/habit_detail_missing_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <TextView
                android:id="@+id/textEmptyMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/habit_detail_missing_message"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="48dp"
            app:visibleIf="@{state.error}">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/habit_list_error_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/textErrorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@{state.errorMessage}"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>
