<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.example.dailyworktracker.data.model.TimeOfDay" />

        <variable
            name="state"
            type="com.example.dailyworktracker.ui.habitlist.HabitListScreenState" />

        <variable
            name="viewModel"
            type="com.example.dailyworktracker.ui.habitlist.HabitListViewModel" />

    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:dateLabel="@{state.selectedDate}"
                app:relativeTo="@{state.today}"
                tools:title="@string/habit_list_title" />

            <!--
              The date strip lives in the AppBarLayout rather than the content area so it stays on
              screen in every display state. If it were part of the content it would disappear on an
              empty past day, leaving no control to navigate back.

              It scrolls back as far as the oldest habit, so every day the app has history for is
              reachable without the arrows the mockup drops. The calendar picker moves to the
              toolbar, for a jump further back than scrolling is worth.
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerDayStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingBottom="8dp"
                app:items="@{state.days}"
                tools:itemCount="7"
                tools:listitem="@layout/item_date_strip_day" />

            <!--
              Part-of-day filter. Sits in the AppBarLayout with the date bar for the same reason:
              it must stay reachable when the filter itself is what emptied the list.

              onClick rather than a checked-change listener, because the checked state is bound
              from the filter and a change listener would echo that binding straight back.
            -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingBottom="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupTimeFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTimeAll"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:checked="@{state.timeFilter == null}"
                        android:onClick="@{() -> viewModel.onAllTimesSelected()}"
                        android:text="@string/time_filter_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTimeMorning"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:checked="@{state.timeFilter == TimeOfDay.MORNING}"
                        android:onClick="@{() -> viewModel.onTimeFilterSelected(TimeOfDay.MORNING)}"
                        android:text="@string/time_of_day_morning" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTimeAfternoon"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:checked="@{state.timeFilter == TimeOfDay.AFTERNOON}"
                        android:onClick="@{() -> viewModel.onTimeFilterSelected(TimeOfDay.AFTERNOON)}"
                        android:text="@string/time_of_day_afternoon" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTimeEvening"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:checked="@{state.timeFilter == TimeOfDay.EVENING}"
                        android:onClick="@{() -> viewModel.onTimeFilterSelected(TimeOfDay.EVENING)}"
                        android:text="@string/time_of_day_evening" />

                </com.google.android.material.chip.ChipGroup>

            </HorizontalScrollView>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHabits"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="96dp"
            app:items="@{state.rows}"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            app:visibleIf="@{state.content}"
            tools:itemCount="4"
            tools:listitem="@layout/item_habit" />

        <androidx.core.widget.ContentLoadingProgressBar
            android:id="@+id/progressLoading"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:visibleIf="@{state.loading}" />

        <LinearLayout
            android:id="@+id/groupEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="48dp"
            app:visibleIf="@{state.empty}"
            tools:visibility="visible">

            <TextView
                android:id="@+id/textEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                app:textRes="@{state.emptyTitleRes}"
                tools:text="@string/habit_list_empty_title" />

            <TextView
                android:id="@+id/textEmptyMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:textRes="@{state.emptyMessageRes}"
                tools:text="@string/habit_list_empty_message" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="48dp"
            app:visibleIf="@{state.error}"
            tools:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/habit_list_error_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/textErrorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@{state.errorMessage}"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Database unavailable" />

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>
