<?xml version="1.0" encoding="utf-8"?><!--
  One day on the date strip: the weekday letters above the day number.

  Plain view binding rather than data binding - the selected and today states are drawn in code,
  where the same colour helpers the rest of the screen uses are reachable.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/containerDay"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="6dp"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/textWeekday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="MO" />

    <TextView
        android:id="@+id/textDayNumber"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        tools:text="22" />

</LinearLayout>
