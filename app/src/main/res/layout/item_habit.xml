<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.example.dailyworktracker.ui.habitlist.HabitListItemUiModel" />

    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="6dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <!--
          A skipped day is dimmed here rather than on the card, because RecyclerView's default
          item animator animates the row root's alpha on a change and would reset ours to 1.
        -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="@{item.skipped ? 0.5f : 1f}"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="4dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/textEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@{item.emoji}"
                android:textSize="28sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="&#x1FAA5;" />

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{item.title}"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                app:layout_constraintEnd_toStartOf="@id/checkboxCompleted"
                app:layout_constraintStart_toEndOf="@id/textEmoji"
                app:layout_constraintTop_toTopOf="@id/textEmoji"
                tools:text="Brush teeth" />

            <TextView
                android:id="@+id/textSchedule"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintEnd_toEndOf="@id/textTitle"
                app:layout_constraintStart_toStartOf="@id/textTitle"
                app:layout_constraintTop_toBottomOf="@id/textTitle"
                app:scheduleBitmask="@{item.scheduleDaysBitmask}"
                tools:text="Every day" />

            <TextView
                android:id="@+id/textStreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorPrimary"
                app:layout_constraintStart_toStartOf="@id/textTitle"
                app:layout_constraintTop_toBottomOf="@id/textSchedule"
                app:streakCount="@{item.currentStreak}"
                tools:text="&#x1F525; 5 day streak"
                tools:visibility="visible" />

            <!--
              A row is ticked off, logged, or skipped, never two at once: all three controls occupy
              the same slot and exactly one of them is on screen. A skipped day offers neither the
              checkbox nor the amount button, because there is nothing to record on a day the user
              has decided to pass on.
            -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkboxCompleted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="@{item.completed}"
                android:contentDescription="@{@string/habit_completed_checkbox(item.title)}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/buttonMore"
                app:layout_constraintTop_toTopOf="parent"
                app:visibleIf="@{item.showsCheckbox}" />

            <ImageView
                android:id="@+id/imageSkipped"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@{@string/habit_skipped_label(item.title)}"
                android:padding="12dp"
                android:src="@drawable/ic_skip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/buttonMore"
                app:layout_constraintTop_toTopOf="parent"
                app:visibleIf="@{item.skipped}"
                tools:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAmount"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@{@string/habit_amount_description(item.title)}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/buttonMore"
                app:layout_constraintTop_toTopOf="parent"
                app:loggedAmount="@{item.amount}"
                app:loggedUnit="@{item.unit}"
                app:visibleIf="@{item.showsAmount}"
                tools:text="12 pages" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonMore"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@{@string/habit_list_more_options(item.title)}"
                app:icon="@drawable/ic_more_vert"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</layout>
