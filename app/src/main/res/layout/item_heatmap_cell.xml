<?xml version="1.0" encoding="utf-8"?><!--
  One day in the history grid. A fixed square centred in its column keeps the grid even across
  screen widths without measuring anything at runtime.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="3dp">

    <View
        android:id="@+id/viewCell"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_heatmap_cell" />

</FrameLayout>
